# Copy to .env.local and fill in. Never commit real keys.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (required for premium agents)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM providers (optional, comma-separate multiple keys to rotate)
GEMINI_API_KEYS=
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
# OLLAMA_URL=http://localhost:11434

# Twilio SMS (optional, demo mode when blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
